<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("partials/head") %>
    <title>Read - Blog</title>
</head>
<body>
    <%- include("partials/navbar") %>

    <main class="pt-8 pb-16 lg:pt-16 lg:pb-24 bg-black antialiased">
        <div class="flex justify-between px-4 mx-auto max-w-screen-xl ">
            <article class="mx-auto w-full max-w-2xl format format-sm sm:format-base lg:format-lg format-blue dark:format-invert">
                <header class="mb-4 lg:mb-6 not-format">
                    <address class="flex items-center mb-6 not-italic">
                        <div class="inline-flex items-center mr-3 text-sm text-gray-900 dark:text-white">
                            <img class="mr-4 w-16 h-16 rounded-full" src="<%= blog.createdBy.profileImgUrl %>" alt="Jese Leos">
                            <div>
                                <a href="#" rel="author" class="text-xl font-bold text-white"><%= blog.createdBy.fullName %></a>
                                <p class="text-base text-gray-400"><%= blog.createdBy.email %></p>
                            </div>
                        </div>
                    </address>
                    <h1 class="mb-4 text-3xl font-extrabold leading-tight lg:mb-6 lg:text-4xl text-white"><%= blog.title %></h1>
                </header>
                <figure><img src="/<%= blog.coverImgUrl %>" alt="Blog Cover Image" class="w-full h-auto" >
                </figure>
                <p class="mt-10 text-white">
                    <%= blog.body %>
                </p>  

                <section class="not-format mt-10">
                    <div class="flex justify-between items-center mb-6">
                        <h2 class="text-lg lg:text-2xl font-bold text-white">Comments (<%= comments.length %>)</h2>
                    </div>
                    <% if (locals.user) { %>
                        <form class="mb-6" method="post" action="/blog/comment/<%= blog._id %>" enctype="application/x-www-form-urlencoded">
                            <div class="py-2 px-4 mb-4 bg-white rounded-lg rounded-t-lg border border-gray-200 dark:bg-gray-800 dark:border-gray-700">
                                <label for="comment" class="sr-only">Your comment</label>
                                <textarea name="content" rows="6" 
                                    class="px-0 w-full text-sm text-gray-900 border-0 focus:ring-0 dark:text-white dark:placeholder-gray-400 dark:bg-gray-800"
                                    placeholder="Write a comment..." 
                                    name="content" required></textarea>
                            </div>
                            <button type="submit"
                                class="inline-flex items-center py-2.5 px-4 text-xs font-medium text-center text-white bg-purple-700 rounded-lg focus:ring-4 focus:ring-primary-200 dark:focus:ring-primary-900 hover:bg-primary-800">
                                Post comment
                            </button>
                        </form>                        
                    <% } %>
                    <% comments.forEach(comment => { %>
                        <article class="p-6 text-base rounded-lg bg-black">
                            <footer class="flex justify-between items-center">
                                <div class="flex items-center">
                                    <p class="inline-flex items-center mr-3 font-semibold text-sm text-white"><img
                                            class="mr-2 w-6 h-6 rounded-full"
                                            src="<%= comment.createdBy.profileImgUrl %>"
                                            alt="Michael Gough"><%= comment.createdBy.fullName %></p>
                                </div>
                            </footer>
                            <p class="text-white"><%= comment.content %></p>
                        </article>
                    <% }) %>
                </section>
            </article>
        </div>
    </main>
    <%- include("partials/footer") %>
</body>
    <%- include("partials/scripts") %>
</html>