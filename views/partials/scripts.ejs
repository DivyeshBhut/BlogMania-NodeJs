    document.addEventListener('DOMContentLoaded', function () {
        const btnDropDown = document.getElementById("dropdownNavbarLink");
        const dropDownMenu = document.getElementById("dropdownNavbar");

        // Show the dropdown menu on hover
        btnDropDown.addEventListener("mouseenter", () => {
            dropDownMenu.classList.remove('hidden');
            htmlElement.classList.toggle('dark');
        });

        // Hide the dropdown menu when the mouse leaves the button or the menu
        btnDropDown.addEventListener("mouseleave", () => {
            setTimeout(() => {
                if (!dropDownMenu.matches(':hover')) {
                    dropDownMenu.classList.add('hidden');
                }
            }, 200);
        });

        dropDownMenu.addEventListener("mouseleave", () => {
            dropDownMenu.classList.add('hidden');
        });

        dropDownMenu.addEventListener("mouseenter", () => {
            dropDownMenu.classList.remove('hidden');
        });

    });

    //toogle button
    const toggleButton = document.getElementById('navbar-toggle');
    const navbarDropdown = document.getElementById('navbar-dropdown');

    toggleButton.addEventListener('click', function () {
      navbarDropdown.classList.toggle('hidden');
    });
</script>